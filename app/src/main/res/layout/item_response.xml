<?xml version="1.0" encoding="utf-8"?>
<!--
  Tarjeta del historial de respuestas en MainActivity. Versión simplificada:
  todo el procesamiento ahora va por la API (panel del relay) y el cliente solo
  muestra el resultado final que llega. Eliminados los placeholders de IAs
  individuales (GPT/Claude/Gemini con "esperando"/"USAR") y el campo Cómplice
  porque eran del flujo viejo de fallback directo desde el móvil — ahora ese
  rol lo cumple el panel /panel del relay.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#1A1A1A"
    android:elevation="2dp">

    <!-- Encabezado: nombre del archivo + tiempo total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvResponseFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BURST_123456.jpg"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45s"
            android:textColor="#555555"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- RESULTADO FINAL (lo que se vibró al usuario) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#002A00"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESPUESTA"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResponseLetter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="---"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:gravity="center" />
    </LinearLayout>

    <!-- Detalle/Raw del proceso (lo manda el servicio: provider, tiempos, fases…) -->
    <TextView
        android:id="@+id/tvRawResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Detalles del proceso…"
        android:textColor="#666666"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:ellipsize="end" />

</LinearLayout>
